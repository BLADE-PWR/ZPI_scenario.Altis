// =====================================================================
//  ZPI scene pack - mission description
// =====================================================================
author          = "Mateusz and Miłosz";
onLoadName      = "ZPI drone dataset generator";
onLoadMission   = "Test scenes for soldier / armour detection from a drone camera";
briefing        = 0;
debriefing      = 0;
disabledAI      = 1;
enableDebugConsole = 2;
saving          = 0;

// One square of the frame-number bar: 4x4 screen pixels, no text.
class ZPI_Square {
    idc = -1;
    type = 0;          // CT_STATIC
    style = 0;
    x = 0;
    y = "safeZoneY";
    w = "4 * pixelW";
    h = "4 * pixelH";
    font = "RobotoCondensed";
    sizeEx = 0.02;
    shadow = 0;
    text = "";
    colorText[] = {0,0,0,0};
    colorBackground[] = {0,0,0,1};
};

class RscTitles {
    // Frame-number bar, physical top-left corner of the screen. Layout (screen pixels):
    //   y = 0..3; square k at x = 4 * k
    //   k = 0 white sentinel, k = 1 black sentinel, k = 2..13 bits 0..11 (LSB first)
    // safeZoneXAbs (whole screen), not safeZoneX (safe zone): the bar must sit at pixel 0,
    // where the decoder's fixed origin is, whatever the user's interface size.
    // Decoder: tools/frame_code.py
    class ZPI_FrameCode {
        idd = -1;
        duration = 1e+011;
        fadeIn = 0;
        fadeOut = 0;
        movingEnable = 0;
        onLoad = "uiNamespace setVariable ['ZPI_frameCodeDisplay', _this select 0]";
        class controls {
            class Sentinel0 : ZPI_Square {
                idc = 1098;
                x = "safeZoneXAbs";
                colorBackground[] = {1,1,1,1};
            };
            class Sentinel1 : ZPI_Square {
                idc = 1099;
                x = "safeZoneXAbs + 4 * pixelW";
            };
            class Bit0 : ZPI_Square {
                idc = 1100;
                x = "safeZoneXAbs + 8 * pixelW";
            };
            class Bit1 : ZPI_Square {
                idc = 1101;
                x = "safeZoneXAbs + 12 * pixelW";
            };
            class Bit2 : ZPI_Square {
                idc = 1102;
                x = "safeZoneXAbs + 16 * pixelW";
            };
            class Bit3 : ZPI_Square {
                idc = 1103;
                x = "safeZoneXAbs + 20 * pixelW";
            };
            class Bit4 : ZPI_Square {
                idc = 1104;
                x = "safeZoneXAbs + 24 * pixelW";
            };
            class Bit5 : ZPI_Square {
                idc = 1105;
                x = "safeZoneXAbs + 28 * pixelW";
            };
            class Bit6 : ZPI_Square {
                idc = 1106;
                x = "safeZoneXAbs + 32 * pixelW";
            };
            class Bit7 : ZPI_Square {
                idc = 1107;
                x = "safeZoneXAbs + 36 * pixelW";
            };
            class Bit8 : ZPI_Square {
                idc = 1108;
                x = "safeZoneXAbs + 40 * pixelW";
            };
            class Bit9 : ZPI_Square {
                idc = 1109;
                x = "safeZoneXAbs + 44 * pixelW";
            };
            class Bit10 : ZPI_Square {
                idc = 1110;
                x = "safeZoneXAbs + 48 * pixelW";
            };
            class Bit11 : ZPI_Square {
                idc = 1111;
                x = "safeZoneXAbs + 52 * pixelW";
            };
        };
    };

    // On-screen readout + crosshair (never part of screenshots: the screenshot command skips UI)
    class ZPI_Hud {
        idd = -1;
        duration = 1e+011;
        fadeIn = 0;
        fadeOut = 0;
        movingEnable = 0;
        onLoad = "uiNamespace setVariable ['ZPI_hudDisplay', _this select 0]";
        class controls {
            class Info {
                idc = 1200;
                type = 0;
                style = 16;            // ST_MULTI: several lines
                lineSpacing = 1;
                x = "safeZoneX + 4 * pixelW";
                y = "safeZoneY + 18 * pixelH";
                w = "760 * pixelW";
                h = "96 * pixelH";
                font = "EtelkaMonospacePro";
                sizeEx = "15 * pixelH";
                shadow = 1;
                text = "";
                colorText[] = {0.6,1,0.6,1};
                colorBackground[] = {0,0,0,0.35};
            };
            class TickL : Info { idc = 1201; style = 0; x = "0.5 - 22 * pixelW"; y = "0.5 - 1 * pixelH"; w = "14 * pixelW"; h = "2 * pixelH"; colorBackground[] = {0.6,1,0.6,0.9}; };
            class TickR : TickL { idc = 1202; x = "0.5 + 8 * pixelW"; };
            class TickT : TickL { idc = 1203; x = "0.5 - 1 * pixelW"; y = "0.5 - 22 * pixelH"; w = "2 * pixelW"; h = "14 * pixelH"; };
            class TickB : TickT { idc = 1204; y = "0.5 + 8 * pixelH"; };
        };
    };
};
